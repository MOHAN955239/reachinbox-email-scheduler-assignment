# --- Server ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Worker tuning ---
WORKER_CONCURRENCY=5
# Minimum delay (ms) enforced between two email sends by a single worker slot.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Global default hourly cap, overridable per-batch from the compose form.
DEFAULT_MAX_EMAILS_PER_HOUR=200

# --- Ethereal SMTP (fake SMTP for testing) ---
# Create test accounts at https://ethereal.email or programmatically via
# nodemailer.createTestAccount() — see README "Ethereal setup".
# You can register several "senders" here as JSON so the scheduler can
# round-robin / rate-limit per sender.
ETHEREAL_SENDERS=[{"email":"sender1@ethereal.email","user":"sender1@ethereal.email","pass":"CHANGE_ME","host":"smtp.ethereal.email","port":587}]

# --- Google OAuth (token verification) ---
# Same client ID used by the Next.js frontend's NextAuth Google provider.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
